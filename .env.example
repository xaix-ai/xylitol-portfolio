# Copy this file to .env and fill in real values. Never commit .env.

# Neon: Dashboard -> your project -> Connect -> copy the connection string.
# Use the normal (direct) one, not the "Pooled connection" one.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# True on your laptop, False (or leave out) on the live site.
DEBUG=True

# Comma-separated domains the site is served from.
ALLOWED_HOSTS=localhost,127.0.0.1
